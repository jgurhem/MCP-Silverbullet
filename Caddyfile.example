# Example reverse proxy for sb_mcp_http.py.
# Caddy handles TLS and authentication; the MCP server itself listens only on
# 127.0.0.1 and is never reachable directly.
#
# Generate the password hash:  caddy hash-password
# `basic_auth` syntax: Caddy >= 2.8 (before that: `basicauth`).

mcp.example.fr {
	basic_auth {
		# user  bcrypt hash (replace)
		jerome $2a$14$Zt1kMFqYFxIiBSCd0000000000000000000000000000000000000
	}

	reverse_proxy 127.0.0.1:8000 {
		# MCP streamable-http responses are SSE: no buffering,
		# otherwise the client waits forever.
		flush_interval -1
	}
}
